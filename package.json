    "@mantine/hooks": "9.1.1",
    "mdast-util-from-markdown": "2.1.0",
    "parse5": "7.3.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "esbuild": "0.25.12",
